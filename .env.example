# Conexión a PostgreSQL
DATABASE_URL=postgres://marketing:marketing@localhost:5432/marketing

# Código que pide la pantalla de primera vez para crear la contraseña (y para recuperarla).
CODIGO_INSTALACION=

# «si» solo para recuperar la contraseña: al arrancar la borra y pide crear una nueva.
REINICIAR_CLAVE=

# Opcional, solo para desarrollo: hash de una contraseña para no pasar por la pantalla de primera vez.
# Se genera con:  npm run clave -- "la-contraseña"
CLAVE_HASH=

# Opcional: secreto para firmar la sesión. Si queda vacío, se genera solo y se guarda en la base.
SESION_SECRETO=

# Días que dura la sesión en un dispositivo
SESION_DIAS=30

# Carpeta para fotos y piezas generadas (en Dokploy, un volumen montado en esta ruta)
MEDIA_DIR=./media

# API del catálogo del ERP
CATALOGO_URL=https://api.saboryaroma.com/api/catalogo-externo
